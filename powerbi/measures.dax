Overview Context Valid = INT(HASONEVALUE('dim_label_window'[label_window]))
Overview Eligible Subscribers = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[eligible_subscribers]))
Overview Active Subscribers = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[active_subscribers]))
Overview Renewed Subscribers = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[observed_renewed_subscribers]))
Overview Churned Subscribers = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[observed_churned_subscribers]))
Overview Renewal Rate = DIVIDE([Overview Renewed Subscribers], [Overview Eligible Subscribers])
Overview Churn Rate = DIVIDE([Overview Churned Subscribers], [Overview Eligible Subscribers])
Overview Gross Receipts Lifetime = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[gross_receipts_lifetime]))
Overview Gross Receipts 30D = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[gross_receipts_30d]))
Overview Gross Receipts 90D = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[gross_receipts_90d]))
Overview Subscription Events = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[subscription_event_count_lifetime]))
Overview Cancellation Events = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[cancellation_event_count_lifetime]))
Overview Cancellation Event Rate = DIVIDE([Overview Cancellation Events], [Overview Subscription Events])
Overview Listening Active Days 30D = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[listening_active_days_30d]))
Overview Listening Active Days 90D = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[listening_active_days_90d]))
Overview Full Completions 30D = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[full_completion_count_30d]))
Overview Corrected Negative Durations 90D = IF([Overview Context Valid] = 1, SUM('fct_retention_overview'[negative_duration_rows_90d]))

Cohort Eligible Subscribers = IF(HASONEVALUE('dim_label_window'[label_window]), SUM('fct_renewal_cohort'[eligible_subscribers]))
Cohort Renewed Subscribers = IF(HASONEVALUE('dim_label_window'[label_window]), SUM('fct_renewal_cohort'[observed_renewed_subscribers]))
Cohort Churned Subscribers = IF(HASONEVALUE('dim_label_window'[label_window]), SUM('fct_renewal_cohort'[observed_churned_subscribers]))
Cohort Renewal Rate = DIVIDE([Cohort Renewed Subscribers], [Cohort Eligible Subscribers])
Cohort Churn Rate = DIVIDE([Cohort Churned Subscribers], [Cohort Eligible Subscribers])
Cohort Gross Receipts 90D = IF(HASONEVALUE('dim_label_window'[label_window]), SUM('fct_renewal_cohort'[gross_receipts_90d]))

Engagement Eligible Subscribers = IF(HASONEVALUE('dim_label_window'[label_window]), SUM('fct_engagement_segment'[eligible_subscribers]))
Engagement Renewed Subscribers = IF(HASONEVALUE('dim_label_window'[label_window]), SUM('fct_engagement_segment'[observed_renewed_subscribers]))
Engagement Churned Subscribers = IF(HASONEVALUE('dim_label_window'[label_window]), SUM('fct_engagement_segment'[observed_churned_subscribers]))
Engagement Renewal Rate = DIVIDE([Engagement Renewed Subscribers], [Engagement Eligible Subscribers])
Engagement Churn Rate = DIVIDE([Engagement Churned Subscribers], [Engagement Eligible Subscribers])
Engagement Average Listening Active Days 30D = IF(HASONEVALUE('dim_label_window'[label_window]), DIVIDE(SUMX('fct_engagement_segment', 'fct_engagement_segment'[average_listening_active_days_30d] * 'fct_engagement_segment'[eligible_subscribers]), SUM('fct_engagement_segment'[eligible_subscribers])))
Engagement Average Listening Seconds 30D = IF(HASONEVALUE('dim_label_window'[label_window]), DIVIDE(SUMX('fct_engagement_segment', 'fct_engagement_segment'[average_listening_seconds_30d] * 'fct_engagement_segment'[eligible_subscribers]), SUM('fct_engagement_segment'[eligible_subscribers])))
Engagement Full Completions 30D = IF(HASONEVALUE('dim_label_window'[label_window]), SUM('fct_engagement_segment'[full_completion_count_30d]))

Subscription Context Valid = INT(HASONEVALUE('dim_label_window'[label_window]) && HASONEVALUE('dim_subscription_segment'[dimension]))
Subscription Eligible Subscribers = IF([Subscription Context Valid] = 1, SUM('fct_subscription_segment'[eligible_subscribers]))
Subscription Renewed Subscribers = IF([Subscription Context Valid] = 1, SUM('fct_subscription_segment'[observed_renewed_subscribers]))
Subscription Churned Subscribers = IF([Subscription Context Valid] = 1, SUM('fct_subscription_segment'[observed_churned_subscribers]))
Subscription Renewal Rate = DIVIDE([Subscription Renewed Subscribers], [Subscription Eligible Subscribers])
Subscription Churn Rate = DIVIDE([Subscription Churned Subscribers], [Subscription Eligible Subscribers])
Subscription Gross Receipts 90D = IF([Subscription Context Valid] = 1, SUM('fct_subscription_segment'[gross_receipts_90d]))
